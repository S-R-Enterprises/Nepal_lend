# Server
PORT=3000
# dev | staging | prod
ENV=dev

# SQLite for local development (created by `npm run prisma:migrate`).
# Production uses Postgres — change the provider in prisma/schema.prisma and
# swap the driver adapter in src/db.ts (see README).
DATABASE_URL="file:./dev.db"

# SMS delivery for OTP (console | http).
# console: prints the code to the server log (never in prod).
# http: POST {to, from, text} to SMS_API_URL with an X-API_KEY header.
SMS_PROVIDER=console
# SMS_PROVIDER=http
# SMS_API_URL=https://your-sms-provider.example/send
# SMS_API_KEY=
# SMS_SENDER_ID=NepalLend
