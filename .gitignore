# Monorepo root ignores — package-specific rules live in each package's own
# .gitignore (e.g. apps/mobile/.gitignore for Flutter).

# Node / tooling (apps/api, packages/*)
node_modules/
.env
.env.*
!.env.example
*.tsbuildinfo

# Build outputs (any package)
**/build/
**/.dart_tool/
**/.flutter-plugins-dependencies
dist/
apps/api/generated/
*.db
*.db-journal
*.db-shm
*.db-wal

# Generated/lock noise
# (keep package lockfiles tracked: pubspec.lock, bun.lock, package-lock.json)

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Secrets — never commit
*.jks
*.keystore
key.properties
*.pem
*.p12

# Logs & coverage
*.log
coverage/
